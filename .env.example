# SMTP (Email sending) — use Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=norahtheceo@gmail.com
SMTP_PASS=your-app-password

# From email address (shown as sender)
FROM_EMAIL=norahtheceo@gmail.com
FROM_NAME=Ashwing VIP Bookings

# IMAP (Email receiving) — usually same as SMTP but with imap host
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=norahtheceo@gmail.com
IMAP_PASS=your-app-password

# Provider email (receives booking notifications)
PROVIDER_EMAIL=norahtheceo@gmail.com

# Provider WhatsApp numbers (receive booking notifications via free WhatsApp API)
# Uses @whiskeysockets/baileys — free, no Twilio needed
# The WhatsApp SENDER is the number linked on the server (currently +27 65 846 8391)
# These are the recipients for provider notifications (hardcoded in server.js):
#   +263 77 575 2700  (Zimbabwe)
#   +27 65 846 8391   (South Africa)

# Server
PORT=3001
NODE_ENV=production
